# Discord Webhook URL
# 取得方式：Discord 頻道設定 → 整合 → Webhooks → 新增 Webhook → 複製 Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Webhook 顯示名稱（覆蓋 Discord 中設定的 Webhook 名稱）
WEBHOOK_USERNAME=台股法人雷達 📡

# Webhook 頭像 URL（留空則使用 Discord 中設定的預設頭像）
# 需為公開可存取的圖片 URL，建議 256x256 px 正方形
WEBHOOK_AVATAR_URL=
